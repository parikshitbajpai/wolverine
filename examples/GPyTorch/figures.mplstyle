font.family : Times
text.usetex : True
axes.titlesize : 14
axes.titleweight : bold
axes.labelsize : 12
lines.linewidth : 2
lines.markersize : 7.5
xtick.labelsize : 11
ytick.labelsize : 11
# legend.title_fontsize : 11
pgf.preamble: \usepackage{siunitx} \usepackage{mhchem}


